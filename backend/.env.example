# Server
PORT=5000
FRONTEND_URL=http://localhost:5173

# Database
MONGO_URI=

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Admin credentials (used for the admin login endpoint)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Email (Brevo SMTP or any SMTP provider)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Order delivery simulation (seconds). Kept configurable instead of
# hard-coded magic numbers scattered across the frontend.
ORDER_PREPARING_AFTER_SECONDS=15
ORDER_OUT_FOR_DELIVERY_AFTER_SECONDS=35
ORDER_DELIVERED_AFTER_SECONDS=60
